# Copier ce fichier en `.env` sur le NAS (à côté de docker-compose.yml)
# Ne jamais committer le vrai `.env` avec les secrets.

# URL publique — doit être définie AVANT `docker compose build`
# (injectée en build arg pour Next.js NEXT_PUBLIC_*).
# Production : https://www.restor-pc.fr
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (G-XXXXXXXX) — vide = désactivé. Avant build Docker.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Variables publiques Supabase (navigateur uniquement — jamais service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hero (optionnel)
NEXT_PUBLIC_HERO_VARIANT=
NEXT_PUBLIC_HERO_MOBILE_VARIANT=

# Opt-in : confiance X-Real-IP / X-Forwarded-For.
# true uniquement si le reverse proxy Synology écrase ces headers ($remote_addr).
TRUST_PROXY_HEADERS=true

RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
