# Copier ce fichier en `.env` sur le NAS (à côté de docker-compose.yml)
# Ne jamais committer le vrai `.env` avec les secrets.

# URL publique — doit être définie AVANT `docker compose build`
# (injectée en build arg pour Next.js NEXT_PUBLIC_*).
# Exemple de forme : https://votre-domaine.example
NEXT_PUBLIC_SITE_URL=

# Variables publiques Supabase (navigateur uniquement — jamais service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hero (optionnel)
NEXT_PUBLIC_HERO_VARIANT=
NEXT_PUBLIC_HERO_MOBILE_VARIANT=

RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
