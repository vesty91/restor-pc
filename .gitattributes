# Normalisation générale : tous les fichiers texte sont stockés en LF dans le
# dépôt et extraits en LF (indépendamment du core.autocrlf de la machine).
* text=auto eol=lf

# Scripts Windows : conservés en CRLF (natif pour cmd.exe / PowerShell).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts destinés à s'exécuter sur le NAS (Linux/busybox) : forcer LF
# pour éviter les erreurs "no such file or directory" (\r dans le shebang)
# quand ces fichiers sont édités/commités depuis Windows.
nas/**/*.sh text eol=lf
nas/**/Dockerfile text eol=lf
nas/**/crontab text eol=lf

# Fichiers binaires : jamais de conversion de fin de ligne.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
