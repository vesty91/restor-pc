# Copier en .env sur le NAS (jamais commité — voir .gitignore).
# Connection string Postgres directe (Supabase Dashboard > Project Settings
# > Database > Connection string > URI, mode "Session pooler").
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Nombre de sauvegardes conservées dans /backups (rotation, défaut 30)
BACKUP_KEEP=30

# Notification push (ntfy.sh) à chaque exécution, succès et échec
NTFY_TOPIC=restor-pc-backup-xxxxxxxxxxxx
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
