# Contact email via Resend (obligatoire en production)
RESEND_API_KEY=your-resend-api-key
CONTACT_TO_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=Restor-PC <noreply@example.com>

# URL publique (canonical, checkout, sitemap)
NEXT_PUBLIC_SITE_URL=https://atelier.restor-pc.fr

# Hero : three | color-panels | static (jamais Three.js + panels simultanés)
# Desktop / défaut
NEXT_PUBLIC_HERO_VARIANT=three
# Mobile / appareils étroits — préférer color-panels ou static
NEXT_PUBLIC_HERO_MOBILE_VARIANT=color-panels

# Stripe Live verrouillé tant que non validé explicitement
ALLOW_STRIPE_LIVE=false
TERMS_VERSION=2026-07-01

# Médiateur consommation (ne pas inventer de valeurs légales)
NEXT_PUBLIC_CONSUMER_MEDIATOR_NAME=
NEXT_PUBLIC_CONSUMER_MEDIATOR_ADDRESS=
NEXT_PUBLIC_CONSUMER_MEDIATOR_WEBSITE=
CONSUMER_MEDIATOR_NAME=
CONSUMER_MEDIATOR_ADDRESS=
CONSUMER_MEDIATOR_WEBSITE=

# Stripe (sk_test_… uniquement tant que ALLOW_STRIPE_LIVE=false)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_CHANGER_DNS=
STRIPE_PRICE_CONTROLE_INTEGRITE=
STRIPE_PRICE_CREATEUR_ISO=
STRIPE_PRICE_DESACTIVER_SERVICES=
STRIPE_PRICE_EXPORT_IDENTIFIANTS=
STRIPE_PRICE_INSTALLATEUR_ATELIER=
STRIPE_PRICE_MAPPER_PARTAGES=
STRIPE_PRICE_NETTOYAGE_WINDOWS=
STRIPE_PRICE_PILOTES_HORS_LIGNE=
STRIPE_PRICE_RAPPORT_BATTERIE=
STRIPE_PRICE_RAPPORT_LOGICIELS=
STRIPE_PRICE_RESET_RESEAU=
STRIPE_PRICE_SAUVEGARDE_PROFILS=
STRIPE_PRICE_SAUVEGARDE_USB=
STRIPE_PRICE_SAUVEGARDE_WIFI=
STRIPE_PRICE_TELEMETRIE=
STRIPE_PRICE_TEST_RESEAU_DUAL=
STRIPE_PRICE_PACK_COMPLET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

PURCHASE_EMAIL_BCC=contact@example.com

# Synology DSM (placeholders — pas d’hôte réel)
NAS_DSM_URL=https://nas.example.com
NAS_USER=nas-api-user
NAS_PASS=your-nas-password
NAS_PUBLIC_BASE=https://nas.example.com
# Timeout HTTP pour les appels DSM Synology (millisecondes).
# Défaut : 10000 — Maximum accepté : 60000.
# Variable non sensible.
NAS_HTTP_TIMEOUT_MS=10000
NAS_SSH_FALLBACK_ENABLED=false
NAS_SSH_HOST=192.168.x.x
NAS_SSH_USER=nas-ssh-user
NAS_SSH_PASS=your-nas-ssh-password
# NAS_SSH_PORT=22

# Admin atelier — cookie = session HMAC (jamais le secret en clair)
ATELIER_SECRET=your-atelier-password
ATELIER_SESSION_SECRET=your-long-random-session-signing-secret

# Health ready (optionnel) — header x-health-token
HEALTH_READY_TOKEN=

# Alertes optionnelles (webhook interne Slack/Discord/etc.)
ALERT_WEBHOOK_URL=

# Faire confiance à x-forwarded-for (Synology / reverse-proxy = true)
TRUST_PROXY_HEADERS=true
