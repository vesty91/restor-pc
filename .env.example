# Supabase (service role = serveur uniquement, jamais NEXT_PUBLIC_*)
SUPABASE_URL=https://rjymdpstakbrbqtfpomj.supabase.co
# ou NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Synology DSM API (création liens File Station 1 DL)
