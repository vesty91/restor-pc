PURCHASE_EMAIL_BCC=contact@restor-pc.fr

# Synology DSM
NAS_DSM_URL=https://nas.restor-pc.fr
NAS_USER=restorpc-api
NAS_PASS=
NAS_PUBLIC_BASE=https://nas.restor-pc.fr
NAS_SSH_FALLBACK_ENABLED=false
NAS_SSH_HOST=192.168.1.5
NAS_SSH_USER=vesty
