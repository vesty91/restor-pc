# Supabase
SUPABASE_URL=https://rjymdpstakbrbqtfpomj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://rjymdpstakbrbqtfpomj.supabase.co
