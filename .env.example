# Contact email via Resend (obligatoire en production)
# 1. Créez un compte Resend : https://resend.com
# 2. Vérifiez votre domaine (ex. restor-pc.fr)
# 3. Créez une clé API
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@restor-pc.fr
# Doit utiliser un domaine vérifié, ex. :
# CONTACT_FROM_EMAIL=Restor-PC <contact@restor-pc.fr>
CONTACT_FROM_EMAIL=
